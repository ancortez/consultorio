# Copiar a .env y ajustar. El archivo .env NO se sube al repositorio.
#
# NOTA SOBRE PUERTOS: se eligieron valores poco comunes a proposito, para
# no chocar con otros contenedores que ya esten corriendo. Si aun asi hay
# conflicto, iniciar.command busca solo el siguiente puerto libre.

APP_ENV=desarrollo
APP_PORT=8090
APP_TZ=America/Mazatlan

DB_NAME=consultorio_dental
DB_USER=consultorio
DB_PASS=consultorio
DB_ROOT_PASS=root
DB_PORT_HOST=3310

PMA_PORT=8091

# ---------------------------------------------------------------------
# MinIO (proyecto aparte: infra/minio)
# El endpoint usa el nombre del contenedor, no localhost: la app le habla
# por dentro de Docker.
# ---------------------------------------------------------------------
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=consultorio-dental
MINIO_LLAVE=minioadmin
MINIO_SECRETO=minioadmin123
