# Copiar a .env. Este archivo NO se sube al repositorio.

MINIO_USUARIO=minioadmin
MINIO_PASSWORD=minioadmin123

# Puertos en tu Mac. Se eligieron 9100 y 9101 en vez de los tipicos
# 9000 y 9001 para no chocar con otros contenedores.
MINIO_PORT_API=9100
MINIO_PORT_CONSOLA=9101

# Un bucket por sistema, separados por comas.
# Ejemplo: consultorio-dental,haixa,otro-sistema
MINIO_BUCKETS=consultorio-dental
