# Las contrasenias nunca al repositorio. El patron sin diagonal cubre
# cualquier nivel, incluido infra/produccion/.env y infra/minio/.env.
.env
.env.*
!.env.example

# La direccion del servidor: es de esta computadora, no del proyecto.
.servidor

# Respaldos: traen el expediente clinico completo.
*.sql.gz
*.tar.gz.enc

storage/logs/*
!storage/logs/.gitkeep

# Los respaldos de prueba de la copia local. Traen el expediente
# clinico completo igual que los de produccion.
storage/respaldos/*
!storage/respaldos/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep

# Volcados que hace migrar.sh antes de tocar la base en local. Traen el
# expediente completo de cada paciente: nunca van al repositorio.
storage/respaldos/
vendor/
node_modules/
*.log
.DS_Store
.idea/
.vscode/
